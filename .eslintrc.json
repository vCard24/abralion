{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "ignorePatterns": ["**/vendor/**", "products-data.min.js", "products-data.js"],
  "globals": {
    "ABRALION_CATALOG": "readonly",
    "ABRALION_COMPARE_PREFILL_KEY": "readonly",
    "ABRALION_IMAGE": "readonly",
    "AbralionIcons": "readonly",
    "CompareManager": "readonly",
    "FormValidator": "readonly",
    "GalleryLightbox": "readonly",
    "Header": "readonly",
    "MegaMenu": "readonly",
    "OG_DEFAULT_IMAGE": "readonly",
    "OG_SITE_ORIGIN": "readonly",
    "ProductCard": "readonly",
    "ProductManager": "readonly",
    "QuoteManager": "readonly",
    "VariantDisplay": "readonly",
    "absolutizeSiteUrl": "readonly",
    "bindGalleryImageFallback": "readonly",
    "bindProductImageFallback": "readonly",
    "buildProductImageCandidates": "readonly",
    "buildQuotePageUrl": "readonly",
    "buildSingleImageCandidates": "readonly",
    "collectCompareKeysForQuote": "readonly",
    "compareManager": "readonly",
    "documentDownloadFilename": "readonly",
    "encodeCompareKeysForUrl": "readonly",
    "ensureAbralionPdfLogoDataUrl": "readonly",
    "getBasePath": "readonly",
    "getCompareKeysForPrefill": "readonly",
    "getSpecColumnClass": "readonly",
    "getTableColumns": "readonly",
    "html2canvas": "readonly",
    "initGalleryLightbox": "readonly",
    "initPdfDownloadLinks": "readonly",
    "initPdfLinks": "readonly",
    "initProductGallery": "readonly",
    "isQuoteFromCompare": "readonly",
    "jspdf": "readonly",
    "navigateToQuotePage": "readonly",
    "parseModelsFromUrl": "readonly",
    "primaryProductImageSrc": "readonly",
    "productImageRelForFetch": "readonly",
    "productOgImage": "readonly",
    "productMenuThumbUrl": "readonly",
    "productThumbUrl": "readonly",
    "productUrl": "readonly",
    "quoteManager": "readonly",
    "readCompareListFromStorage": "readonly",
    "readComparePrefillForQuote": "readonly",
    "renderProductCards": "readonly",
    "resolveCatalogKeys": "readonly",
    "sanitizeDownloadLabel": "readonly",
    "saveComparePrefillForQuote": "readonly",
    "sendFormMail": "readonly",
    "setPageSocialMeta": "readonly",
    "variantLabel": "readonly",
    "variantRowCells": "readonly",
    "variantSpecLines": "readonly"
  },
  "rules": {
    "no-redeclare": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-unreachable": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-empty": ["warn", { "allowEmptyCatch": true }]
  }
}
